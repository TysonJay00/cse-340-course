<%- include('partials/header') %>

    <main>
        <h1>
            Service Project Categories
        </h1>

        <ul>
            <% categories.forEach(category=> { %>
                <li>
                    <a href="/category/<%= category.categories_id %>">
                        <%=category.title %>
                    </a>
                </li>
                <% }) %>

        </ul>
        <a href="/new-category"> Add a New Category</a>

    </main>

    <%- include('partials/footer') %>