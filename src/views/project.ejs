<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <h2>
            <%= projectDetails.title %>
        </h2>

        <p>Description: <%= projectDetails.description %>
        </p>

        <p>Location: <%= projectDetails.location %>
        </p>

        <p>
            Date:
            <%= new Date(projectDetails.date).toLocaleDateString('en-US', { year: 'numeric' , month: 'long' ,
                day: 'numeric' , timeZone: 'UTC' }) %>
        </p>

        <p>
            Organization:
            <a href="/organization/<%= projectDetails.organization_id %>">
                <%= projectDetails.organization_name %>
            </a>
        </p>

        <h3>Categories</h3>

        <% categories.forEach(category=> { %>
            <span>
                <a href="/category/<%= category.categories_id %>">
                    <%= category.title %>
                </a>
            </span>
            &nbsp;
            <% }) %>

                <a href="/assign-categories/<%= projectDetails.project_id %>">
                    Edit Categories
                </a>
                <p><a href="/edit-project/<%= projectDetails.project_id %>">Edit Project</a></p>
    </main>

    <%- include('partials/footer') %>